# Copie para .env (na raiz para o docker compose, ou em backend/ para rodar a API direto).
# Nunca faça commit do arquivo .env.
# desenvolvimento ou producao. Em producao a API recusa os valores de exemplo abaixo.
AMBIENTE=desenvolvimento
POSTGRES_PASSWORD=equilibra
API_KEY=troque-esta-chave
DATABASE_URL=postgresql+psycopg://equilibra:equilibra@localhost:5432/equilibra
# Assina os tokens de login. Gere um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=troque-este-segredo-jwt-com-pelo-menos-32-caracteres
